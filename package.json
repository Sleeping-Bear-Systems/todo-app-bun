{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "todo-app",
  "module": "index.ts",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "bun run ./src/index.ts",
    "dev": "bun run --watch ./src/index.ts",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "ts:check": "tsc --noEmit"
  },
  "private": true,
  "type": "module"
}
